@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager




<PageTitle>Welcome</PageTitle>


<div class="main-content">
    <DxGridLayout CssClass="welcome-gridlayout" RowSpacing="3rem">
        <Rows>
            <DxGridLayoutRow Height="auto" Areas="header"></DxGridLayoutRow>
            <DxGridLayoutRow Height="auto" Areas="cards"></DxGridLayoutRow>
        </Rows>
        <Items>
            <DxGridLayoutItem Area="header" CssClass="title">
                <Template>
                    <div class="title-header-text">Welcome to e-ITPR!</div>
                    <div class="title-content-text">Please select your actions below.</div>
                </Template>
            </DxGridLayoutItem>
            <DxGridLayoutItem Area="cards" CssClass="welcome-cards">
                <Template>
                    <NavLink class="welcome-card" @onclick="@(() => navigate("counter?statusId=1"))" href="">
                        <img src="images/submit_doc.svg" class="welcome-card-img"/>
                    
                        <div class="welcome-card-text" >
                            Create e-ITPR
                         </div>
                        <div class="welcome-card-back"></div>
                    </NavLink>
                    <NavLink class="welcome-card" @onclick="@(() => navigate("view"))" href="">
                        <img src="images/open_doc.svg" class="welcome-card-img" />
                     @*    <svg class="welcome-card-img" alt="weather card">
                            <use href="images/cards.svg#weather"></use>
                        </svg> *@
                        <div class="welcome-card-text">View my e-ITPR</div>
                        <div class="welcome-card-back"></div>
                    </NavLink>
                </Template>
            </DxGridLayoutItem>
        </Items>
    </DxGridLayout>
</div>

@code {
    protected void navigate(string url) {
        NavigationManager.NavigateTo($"/{url}", true);
    }
 }