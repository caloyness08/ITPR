@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IFileVersionProvider FileVersionProvider

<!DOCTYPE html>
<html lang="en" >
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @DxResourceManager.RegisterScripts()
    <link href=@AppendVersion("css/blazing-berry.bs5.css") rel="stylesheet" />
    <link href=@AppendVersion("css/site.css") rel="stylesheet" />
    <link href=@AppendVersion("css/eITPR.styles.css") rel="stylesheet" />
    <link href=@AppendVersion("css/icons.css") rel="stylesheet" />
    <link href=@AppendVersion("css/userProfile.css") rel="stylesheet" />
    <link href=@AppendVersion("css/searchItem.css") rel="stylesheet" />
    <link href=@AppendVersion("css/stepper.css") rel="stylesheet" />
    <link href=@AppendVersion("css/flexBox.css") rel="stylesheet" />
    <link href=@AppendVersion("css/validation.css") rel="stylesheet" />
    <link href=@AppendVersion("css/gridToolBar.css") rel="stylesheet" />
    <HeadOutlet />
</head>
<body>
    <Routes></Routes>
    <script src="../scripts/jquery-3.7.1.js"></script>
    <script src="_framework/blazor.web.js"></script>
    @* <script src=@AppendVersion("scripts/stepper.js") type="text/javascript"></script> *@
    <script src="../scripts/stepper.js"></script>
</body>

</html>

@code{
    private string AppendVersion(string path) => FileVersionProvider.AddFileVersionToPath("/", path);
}